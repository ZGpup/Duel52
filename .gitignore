# Rust
# The Cargo workspace root is the repo root, so build output lands in /target.
/target/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# The compiled Rust extension, dropped into the package by `maturin develop`.
# Rebuild it with `maturin develop --release`; never commit it.
*.so
*.pyd
*.dylib

# Training artifacts — never commit these, they belong in object storage
/runs/
/checkpoints/
*.pt
*.ckpt
/data/
/replay_buffers/

# Logs and profiling
*.log
/wandb/
/tensorboard/

# macOS
.DS_Store
